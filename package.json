{
  "name": "toondraw",
  "version": "1.0.0",
  "private": true,
  "description": "ToonDraw - Studio de dessin cartoon interactif pour enfants avec canvas, stickers, super-héros et animations.",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "node scripts/generate-entry.mjs && vite",
    "build": "node scripts/generate-entry.mjs && vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "preview": "vite preview",
    "check": "node scripts/generate-entry.mjs && node scripts/check-modules.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "tailwindcss": "^3.4.19",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1"
  }
}
